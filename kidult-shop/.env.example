# Kopiér til .env og udfyld. .env må ALDRIG committes (den står i .gitignore).
# Indlæs i din terminal med:  set -a; source .env; set +a

# Din butiks interne Shopify-adresse (ikke dit .dk-domæne)
SHOPIFY_FLAG_STORE=din-butik.myshopify.com

# Kun nødvendig til automatisk upload (CI). Lokalt logger du bare ind i browseren.
# Oprettes via appen "Theme Access" i Shopify-admin.
SHOPIFY_CLI_THEME_TOKEN=
